# Chave Web do Firebase usada pelo login. Obrigatória também no desenvolvimento local.
VITE_FIREBASE_API_KEY=cole_a_nova_chave_aqui

# OAuth Client ID público usado pelo Google Identity Services.
# Deixe vazio para usar o cliente já configurado no projeto Firebase atual.
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Opcional: URL de um backend privado que valide o token Firebase do header Authorization.
# Deixe vazia para ler a planilha privada diretamente após a autorização Google.
VITE_DATA_BASE_URL=
